# Pick ONE provider (default: openrouter)
LLM_PROVIDER=openrouter

# OpenRouter (shared multi-provider routing)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
SITE_URL=https://your-deployed-url.vercel.app

# Baseten (dedicated inference — set LLM_PROVIDER=baseten to use)
# Get values from your Baseten dashboard: Model APIs use
#   BASETEN_URL=https://inference.baseten.co/v1/chat/completions
#   BASETEN_MODEL=<your model slug, e.g. baseten/deepseek-ai/DeepSeek-V4.1-Flash>
# Dedicated deployments use their own /sync/v1 URL as BASETEN_URL.
BASETEN_API_KEY=
BASETEN_MODEL=baseten/deepseek-ai/DeepSeek-V4.1-Flash
# BASETEN_URL=https://inference.baseten.co/v1/chat/completions
# Socratic follow-up turns (tutor-dialogue capability). A DIALOGUE-SPECIFIC
# small model is required — dialogue never falls back to the generation
# model. Without one, the quiz uses static hints instead.
# LLM_DIALOGUE_PROVIDER=baseten
# BASETEN_DIALOGUE_MODEL=<small cheap slug on your account>
# OPENROUTER_DIALOGUE_MODEL=<small cheap slug>

# Supabase classroom store (server SDK reads these; browser reads NEXT_PUBLIC_*)
# Run supabase/schema.sql in the SQL editor, then mirror the values:
#   SUPABASE_URL=https://xyz.supabase.co
#   SUPABASE_ANON_KEY=<anon key>
#   NEXT_PUBLIC_SUPABASE_URL=https://xyz.supabase.co
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>
